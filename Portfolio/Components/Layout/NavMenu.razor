@implements IDisposable
@using Portfolio.ViewModels
@using Portfolio.Application.Dtos

@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<nav class="navbar navbar-expand-md navbar-light bg-light border-bottom mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">Portfolio</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteMenu">
        <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="siteMenu">
            <ul class="navbar-nav me-auto">
                @foreach (var item in viewModel.MenuItems) // menyn som hämtas från api
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/page/{item.PageId}")">@item.Title</NavLink>
                    </li>
                }
            </ul>

            <!-- Admin -->
            <ul class="navbar-nav">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item"><NavLink class="nav-link" href="/admin/pages/view">Pages</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="/admin/menu">Menu</NavLink></li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link btn btn-link">Logout</button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item"><NavLink class="nav-link" href="Account/Login">Login</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>


@code{
    private SiteMenuViewModel viewModel = new();
    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("MenuApi"); //Hämtar den httpclient jag skapat i program.cs
        viewModel.MenuItems = await client.GetFromJsonAsync<List<MenuDto>>("api/menu") ?? []; //Anropar och hämtar
    }
    
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri); //Sparar vilken sida man är på
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location); //Uppdaterar när man byter sida
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}