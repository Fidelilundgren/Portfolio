@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IMenuService MenuService
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-md navbar-light bg-light border-bottom mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">Portfolio</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteMenu">
        <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="siteMenu">
            <ul class="navbar-nav me-auto">
                @foreach (var item in viewModel.MenuItems)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/page/{item.PageId}")">@item.Title</NavLink>
                    </li>
                }
            </ul>

            <!-- Admin -->
            <ul class="navbar-nav">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item"><NavLink class="nav-link" href="/admin/pages/view">Pages</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="/admin/menu">Menu</NavLink></li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link btn btn-link">Logout</button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item"><NavLink class="nav-link" href="Account/Login">Login</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>


@code{
    private SiteMenuViewModel viewModel = new();
    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        viewModel.MenuItems = await MenuService.GetAllAsync();
    }
    
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}