@page "/page/{PageId:int}"
@rendermode InteractiveServer

@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IPageService PageService

<div class="container py-5">
    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (viewModel.Content == null)
    {
        <p>Page not found</p>
    }
    else
    {
        <PageTitle>@viewModel.Content.Title</PageTitle>

        <h1 class="@viewModel.Content.HeadingCss">@viewModel.Content.HeadingText</h1>

        @if (!string.IsNullOrWhiteSpace(viewModel.Content.Text))
        {
            <p class="text-block @viewModel.Content.TextCss">@viewModel.Content.Text</p>
        }

        @if (!string.IsNullOrWhiteSpace(viewModel.Content.ImageUrl))
        {
            <img src="@viewModel.Content.ImageUrl" class="img-fluid d-block mb-4 @viewModel.Content.ImageCss" alt="" />
        }

        @if (!string.IsNullOrWhiteSpace(viewModel.Content.LinkUrl))
        {
            <a href="@viewModel.Content.LinkUrl" class="d-block mb-4 @viewModel.Content.LinkCss"
               target="_blank" rel="noopener noreferrer">@viewModel.Content.LinkText</a>
        }
    }
</div>


@code {
    [Parameter]
    public int PageId { get; set; }

    private DisplayPageViewModel viewModel = new();
    private bool isLoading = true;
    private int lastCountedPageId;

    protected override async Task OnParametersSetAsync()
    {
        viewModel.Content = await PageService.GetContentAsync(PageId);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PageId != lastCountedPageId)
        {
            lastCountedPageId = PageId;
            await PageService.VisitCountAsync(PageId);
        }
    }
}