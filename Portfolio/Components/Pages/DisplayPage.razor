@page "/page/{PageId:int}"
@rendermode InteractiveServer
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IPageService PageService
@inject IBlockService BlockService

<div class="container py-5">

    @if (viewModel.Page == null)
    {
        <p>Page not found</p>
    }
    else
    {
        <PageTitle>@viewModel.Page.Title</PageTitle>
        @if (viewModel.Heading != null)
        {
            <h1 class="@viewModel.Heading.CssClass">@viewModel.Heading.TextContent</h1>
        }

        foreach (var block in viewModel.Texts)
        {
            <p class="@block.CssClass">@block.TextContent</p>
        }

        @if (!string.IsNullOrWhiteSpace(viewModel.Image?.ImageUrl))
        {
            <img src="@viewModel.Image.ImageUrl" class="img-fluid d-block mb-4 @viewModel.Image.CssClass" alt="" />
        }

        @if (viewModel.Link != null)
        {
            <a href="@viewModel.Link.LinkUrl" class="d-block mb-4 @viewModel.Link.CssClass"
            target="_blank" rel="noopener noreferrer">@viewModel.Link.LinkText</a>
        }
    }
    
</div>



@code {
    [Parameter]
    public int PageId { get; set; }

    public DisplayPageViewModel viewModel { get; set; } = new();

    private int lastCountedPageId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PageId != lastCountedPageId)
        {
            lastCountedPageId = PageId;
            await PageService.VisitCountAsync(PageId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        viewModel.Page = await PageService.GetByIdAsync(PageId);
        viewModel.Heading = await BlockService.GetHeadingByPageIdAsync(PageId);
        viewModel.Texts = await BlockService.GetTextsByPageIdAsync(PageId);
        viewModel.Image = await BlockService.GetImageByPageIdAsync(PageId);
        viewModel.Link = await BlockService.GetLinkByPageIdAsync(PageId);
    }
}
