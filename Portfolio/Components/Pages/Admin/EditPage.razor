@page "/admin/pages/edit/{PageId:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels

@inject IPageService PageService
@inject IBlockService BlockService
@inject NavigationManager Navigation

<div class="container py-4" style="max-width: 800px;">
    <h2 class="mb-4">Edit Page</h2>


    <EditForm Model="viewModel" OnSubmit="UpdatePage">
        <DataAnnotationsValidator/>

        <div class="card mb-4">
            <div class="card-body">
                <label class="form-label">Title:</label>
                <InputText class="form-control" @bind-Value="viewModel.Title"/>
                <ValidationMessage class="text-danger small" For="@(() => viewModel.Title)" />
            </div>
        </div>

        @if (viewModel.Heading != null)
        {
            <div class="card mb-4">
                <div class="card-header">Heading:</div>
                <div class="card-body">
                    <InputText class="form-control mb-3" @bind-Value="viewModel.HeadingText" />
                    <ValidationMessage class="text-danger small" For="@(() => viewModel.HeadingText)" />
                    <HeadingFormComponent Model="@viewModel.HeadingStyling" Section="heading" />
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header">Text:</div>
            <div class="card-body">
                <InputTextArea class="form-control mb-3" @bind-Value="viewModel.TextContent" />
                <ValidationMessage class="text-danger small" For="@(() => viewModel.TextContent)" />
                <HeadingFormComponent Model="@viewModel.TextStyling" Section="text" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
    </EditForm>
</div>

@code {

    [Parameter]
    public int PageId { get; set; }

    public EditPageViewModel viewModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var page = await PageService.GetByIdAsync(PageId);

        if (page != null)
        {
            viewModel.Title = page.Title;
            viewModel.Heading = await BlockService.GetHeadingByPageIdAsync(PageId);


            if (viewModel.Heading != null)
            {
                viewModel.HeadingText = viewModel.Heading.TextContent ?? string.Empty;
                viewModel.HeadingStyling.LoadFromCss(viewModel.Heading.CssClass);
            }

            var texts = await BlockService.GetTextsByPageIdAsync(PageId);
            viewModel.Text = texts.FirstOrDefault();

            if (viewModel.Text != null)
            {
                viewModel.TextContent = viewModel.Text.TextContent;
                viewModel.TextStyling.LoadFromCss(viewModel.Text.CssClass);
            }
        }
    }

    public async Task UpdatePage(EditContext editContext)
    {
        if (!editContext.Validate())
        {
            return;
        }

        await PageService.UpdateAsync(viewModel.ToPageDto(PageId));

        if (viewModel.Heading != null)
        {
            viewModel.Heading.TextContent = viewModel.HeadingText;
            viewModel.Heading.CssClass = viewModel.HeadingStyling.GetCss();

            await BlockService.UpdateAsync(viewModel.Heading);
        }

        if (viewModel.Text != null)
        {
            viewModel.Text.TextContent = viewModel.TextContent;
            viewModel.Text.CssClass = viewModel.TextStyling.GetCss();

            await BlockService.UpdateAsync(viewModel.Text);
        }
        else if (!string.IsNullOrWhiteSpace(viewModel.TextContent))
        {
            await BlockService.AddTextAsync(viewModel.ToTextDto(PageId));
        }

        Navigation.NavigateTo("/admin/pages/view");
    }
}
