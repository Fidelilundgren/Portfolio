@page "/admin/pages/edit/{PageId:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels

@inject IPageService PageService
@inject IMenuService MenuService
@inject IImageService ImageService
@inject NavigationManager Navigation

<PageTitle>Edit page</PageTitle>

<div class="admin-container">
    <h2 class="mb-4">Edit Page</h2>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (notFound)
    {
        <p>Page not found.</p>
        <a href="/admin/pages/view" class="btn btn-outline-secondary">Back to pages</a>
    }
    else
    {
        <PageFormComponent Model="viewModel" ButtonText="Update" OnValidSubmit="UpdatePage" />
    }
</div>

@code {
    [Parameter]
    public int PageId { get; set; }

    private PageFormViewModel viewModel = new();
    private bool isLoading = true;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        var content = await PageService.GetContentAsync(PageId);

        if (content == null)
        {
            notFound = true;
        }
        else
        {
            viewModel.LoadFrom(content);
            viewModel.AddToMenu = await MenuService.IsPageInMenuAsync(PageId);
        }

        isLoading = false;
    }

private async Task UpdatePage()
    {
        if (viewModel.UploadedImage != null)
        {
            await using var stream = viewModel.UploadedImage.OpenReadStream(ImageService.MaxFileSize);
            viewModel.ImageUrl = await ImageService.SaveAsync(stream, viewModel.UploadedImage.Name);
        }
        else if (viewModel.RemoveImage)
        {
            viewModel.ImageUrl = null;
        }

        await PageService.UpdateContentAsync(viewModel.ToDto(PageId));

        await MenuService.SetPageInMenuAsync(viewModel.ToMenuDto(PageId), viewModel.AddToMenu);

        Navigation.NavigateTo("/admin/pages/view");
    }
}