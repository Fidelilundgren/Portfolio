@page "/admin/menu"
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IMenuService MenuService
@inject IPageService PageService

<div class="container py-4" style="max-width: 800px;">
    <h2 class="mb-4">Menu</h2>

    <div class="card mb-4">
        <div class="card-header">Add menu item</div>
        <div class="card-body">
            <EditForm Model="viewModel" OnSubmit="AddMenuItem">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Title:</label>
                    <InputText class="form-control" @bind-Value="viewModel.Title" />
                    <ValidationMessage class="text-danger small" For="@(() => viewModel.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Select page:</label>
                    <InputSelect class="form-select" @bind-Value="viewModel.PageId">
                        <option value="0">Select</option>
                        @foreach (var p in viewModel.Pages)
                        {
                            <option value="@p.Id">@p.Title</option>
                        }
                    </InputSelect>
                    <ValidationMessage class="text-danger small" For="@(() => viewModel.PageId)" />
                </div>

                <button type="submit" class="btn btn-primary">Add</button>
            </EditForm>
        </div>
    </div>

    @for (int i = 0; i < viewModel.MenuItems.Count; i++)
    {
        var item = viewModel.MenuItems[i];
        bool isFirst = i == 0;
        bool isLast = i == viewModel.MenuItems.Count - 1;

        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">@item.Title</h5>
                    <small class="text-muted">Page: @viewModel.GetPageTitle(item.PageId)</small>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" disabled="@isFirst" @onclick="() => Move(item.Id, -1)">↑</button>
                    <button class="btn btn-outline-secondary" disabled="@isLast" @onclick="() => Move(item.Id, 1)">↓</button>
                    <button class="btn btn-outline-danger" @onclick="() => Delete(item.Id)">Delete</button>
                </div>
            </div>
        </div>
    }

</div>



@code {
    public MenuViewModel viewModel { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        viewModel.Pages = await PageService.GetAllAsync();
        await LoadMenu();
    }

    private async Task LoadMenu()
    {
        viewModel.MenuItems = await MenuService.GetAllAsync();
    }

    private async Task AddMenuItem(EditContext editContext)
    {
        if (!editContext.Validate())
        {
            return;
        }

        await MenuService.AddAsync(viewModel.ToMenuDto());

        viewModel.Title = string.Empty;
        viewModel.PageId = 0;

        await LoadMenu();
    }

    private async Task Move(int id, int direction)
    {
        await MenuService.MoveAsync(id, direction);
        await LoadMenu();
    }

    private async Task Delete(int id)
    {
        await MenuService.DeleteAsync(id);
        await LoadMenu();
    }
}
