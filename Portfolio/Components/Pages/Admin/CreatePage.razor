@page "/admin/pages/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels

@inject IPageService PageService
@inject IMenuService MenuService
@inject IImageService ImageService
@inject NavigationManager Navigation

<PageTitle>Create page</PageTitle>

<div class="admin-container">
    <h2 class="mb-4">Create Page</h2>
    <PageFormComponent Model="viewModel" ButtonText="Create page" OnValidSubmit="SavePage" />
</div>

@code {

    private PageFormViewModel viewModel = new();

    private async Task SavePage()
    {
        if (viewModel.UploadedImage != null)
        {
            await using var stream = viewModel.UploadedImage.OpenReadStream(ImageService.MaxFileSize);
            viewModel.ImageUrl = await ImageService.SaveAsync(stream, viewModel.UploadedImage.Name);
        }

        int pageId = await PageService.CreateContentAsync(viewModel.ToDto());

        if (viewModel.AddToMenu)
        {
            await MenuService.AddAsync(viewModel.ToMenuDto(pageId));
        }

        Navigation.NavigateTo("/");
    }
}