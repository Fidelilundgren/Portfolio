@page "/admin/pages/create"
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IPageService PageService
@inject IBlockService BlockService
@inject NavigationManager Navigation

<div class="container py-4" style="max-width: 800px;">
    <h2 class="mb-4">Create Page</h2>


    <EditForm Model="viewModel" OnSubmit="AddPage">
        <DataAnnotationsValidator/>

        <div class="card mb-4">
            <div class="card-body">
                <label class="form-label">Page Title:</label>
                <InputText class="form-control" @bind-Value="viewModel.Title"/>
                <ValidationMessage class="text-danger small" For="@(() => viewModel.Title)" />
            </div>
        </div>

        
        <div class="card mb-4">
            <div class="card-header">Heading:</div>
            <div class="card-body">
                <InputTextArea class="form-control mb-3" @bind-Value="viewModel.HeadingText" />
                <ValidationMessage class="text-danger-small" For="@(() => viewModel.HeadingText)" />
                <HeadingFormComponent Model="@viewModel.HeadingStyling" Section="heading" />
            </div>
        </div>
        
        <div class="card mb-4">
            <div class="card-header">Text:</div>
            <div class="card-body">
                <InputTextArea class="form-control mb-3" @bind-Value="viewModel.Text" />
                <HeadingFormComponent Model="viewModel.TextStyling" Section="text" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create Page</button>
    </EditForm>
</div>

@code {

    public CreatePageViewModel viewModel { get; set; } = new();

    public async Task AddPage(EditContext editContext)
    {
        if (!editContext.Validate())
        {
            return;
        }

        int pageId = await PageService.AddAsync(viewModel.ToPageDto());

        await BlockService.AddHeadingAsync(viewModel.ToHeadingDto(pageId));

        if (!string.IsNullOrWhiteSpace(viewModel.Text))
        {
            await BlockService.AddTextAsync(viewModel.ToTextDto(pageId));
        }

        Navigation.NavigateTo($"/page/{pageId}");
    }
}