@page "/admin/pages/view"
@using Portfolio.Application.Interfaces
@using Portfolio.ViewModels
@inject IPageService PageService

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Pages</h2>

        <a href="/admin/pages/create" class="btn btn-primary">Create Page</a>
    </div>

    @foreach(var p in viewModel.Pages)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">@p.Title</h5>
                    <small class="text-muted">Visits: @p.VisitCount</small>
                </div>
                <a href="@($"/page/{p.Id}")" class="btn btn-outline-primary">View</a>
                <a href="@($"/admin/pages/edit/{p.Id}")" class="btn btn-outline-secondary">Edit</a>
            </div>
        </div>
    }
</div>

@code {
    public ViewPageViewModel viewModel { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        viewModel.Pages = await PageService.GetAllAsync();
    }
}